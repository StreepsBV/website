---
import Layout from '../layouts/Layout.astro';
import { portfolio } from '../data/portfolio';
---
<Layout title="Portfolio" description="Explore the yacht and residence painting portfolio of STREEPS.">
  <section class="container portfolio-page">
    <header class="page-intro portfolio-intro">
      <h1>Work that speaks<br />for itself.</h1>
      <p>A selection of yacht and residence projects, finished with precision and care.</p>
    </header>
    <div class="portfolio-grid">
      {portfolio.map((work) => (
        <article class="portfolio-card">
          <a class="portfolio-card-image" href={`/portfolio/${work.slug}/`}>
            <img src={work.image} alt={work.imageAlt} width="1400" height="950" loading="lazy" />
          </a>
          <div class="portfolio-card-copy">
            <span class="portfolio-kicker">{work.category}</span>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="container homepage-social portfolio-social" aria-label="Follow STREEPS">
    <p>See more of our recent work.</p>
    <div class="social-buttons">
      <a class="social-button" href="https://www.instagram.com/streepspainters/" target="_blank" rel="noreferrer">Instagram</a>
      <a class="social-button" href="https://www.facebook.com/profile.php?id=61566968831187" target="_blank" rel="noreferrer">Facebook</a>
    </div>
  </section>
</Layout>
