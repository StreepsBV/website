---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact" description="Contact STREEPS for expert yacht and residence painting.">
  <section class="container contact-page">
    <header>
      <h1>Let&apos;s make it beautiful.</h1>
      <p>Planning a yacht refit or refreshing your residence? Tell us about your project and we&apos;ll be in touch.</p>
    </header>
    <div class="contact-details" aria-label="Contact details">
      <div>
        <span class="contact-label">Email</span>
        <a href="mailto:infostreeps@icloud.com">infostreeps@icloud.com</a>
      </div>
      <div>
        <span class="contact-label">Follow our work</span>
        <div class="social-links">
          <a href="https://www.instagram.com/streepspainters/" target="_blank" rel="noreferrer">Instagram</a>
          <a href="https://www.facebook.com/profile.php?id=61566968831187" target="_blank" rel="noreferrer">Facebook</a>
        </div>
      </div>
    </div>
    <form
      class="contact-form"
      action="https://formsubmit.co/infostreeps@icloud.com"
      method="POST"
    >
      <input type="hidden" name="_subject" value="New painting enquiry from the STREEPS website" />
      <input type="hidden" name="_next" value="/" />
      <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
      <div class="field">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" required autocomplete="name" />
      </div>
      <div class="field">
        <label for="email">Email address</label>
        <input id="email" name="email" type="email" required autocomplete="email" />
      </div>
      <div class="field">
        <label for="message">Message</label>
        <textarea id="message" name="message" required></textarea>
      </div>
      <button class="submit-button" type="submit">Send message</button>
    </form>
  </section>
</Layout>
