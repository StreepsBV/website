---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact" description="Contact STREEPS for expert yacht and residence painting.">
  <section class="container contact-page">
    <header>
      <h1>Let&apos;s make it beautiful.</h1>
      <p>Planning a yacht refit or refreshing your residence? Tell us about your project and we&apos;ll be in touch.</p>
    </header>
    <div class="contact-details" aria-label="Contact details">
      <div>
        <span class="contact-label">Email</span>
        <a href="mailto:infostreeps@icloud.com">infostreeps@icloud.com</a>
      </div>
      <div>
        <span class="contact-label">Follow our work</span>
        <div class="social-links">
          <a href="https://www.instagram.com/streepspainters/" target="_blank" rel="noreferrer">Instagram</a>
          <a href="https://www.facebook.com/profile.php?id=61566968831187" target="_blank" rel="noreferrer">Facebook</a>
        </div>
      </div>
    </div>
    <form id="contact-form" class="contact-form">
      <div class="field">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" required maxlength="150" autocomplete="name" />
      </div>
      <div class="field">
        <label for="email">Email address</label>
        <input id="email" name="email" type="email" required maxlength="254" autocomplete="email" />
      </div>
      <div class="field">
        <label for="message">Message</label>
        <textarea id="message" name="message" required maxlength="5000"></textarea>
      </div>
      <p>This opens a draft in your email application. Send it there to contact us.</p>
      <button class="submit-button" type="submit">Open email draft</button>
      <noscript>
        <p>JavaScript is needed to prepare the draft. Email <a href="mailto:infostreeps@icloud.com">infostreeps@icloud.com</a> directly.</p>
      </noscript>
      <p id="contact-status" role="status"></p>
    </form>
  </section>
</Layout>
<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    const subject = `STREEPS painting enquiry — ${data.get('name')}`;
    const body = `${data.get('message')}\n\n${data.get('name')}\n${data.get('email')}`;
    window.location.href = `mailto:infostreeps@icloud.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

    const status = document.querySelector('#contact-status');
    if (status) {
      status.textContent = 'Email draft requested. If your email application did not open, email infostreeps@icloud.com directly.';
    }
  });
</script>
