---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact" description="Get in touch with STREEPS.">
  <section class="container contact-page">
    <header>
      <h1>Get in touch.</h1>
      <p>Have a question, idea or collaboration in mind? Send us a message.</p>
    </header>
    <form
      class="contact-form"
      action="https://formsubmit.co/infostreeps@icloud.com"
      method="POST"
    >
      <input type="hidden" name="_subject" value="New message from the STREEPS website" />
      <input type="hidden" name="_next" value="/" />
      <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
      <div class="field">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" required autocomplete="name" />
      </div>
      <div class="field">
        <label for="email">Email address</label>
        <input id="email" name="email" type="email" required autocomplete="email" />
      </div>
      <div class="field">
        <label for="message">Message</label>
        <textarea id="message" name="message" required></textarea>
      </div>
      <button class="submit-button" type="submit">Send message</button>
    </form>
  </section>
</Layout>
