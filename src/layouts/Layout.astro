---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'STREEPS',
  description = 'STREEPS',
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageUrl = (path: string) => `${base}${path}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | STREEPS</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#102541" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="wordmark" href={pageUrl('/')} aria-label="STREEPS home">STREEPS</a>
        <span class="brand-caption">Yacht &amp; residence<br />painting</span>
        <nav class="desktop-nav" aria-label="Main navigation">
          <a href={pageUrl('/')}>Home</a>
          <a href={pageUrl('/portfolio/')}>Portfolio</a>
        </nav>
        <a class="header-cta" href={pageUrl('/contact/')}>Contact</a>
        <details class="mobile-nav">
          <summary>Menu</summary>
          <nav aria-label="Mobile navigation">
            <a href={pageUrl('/')}>Home</a>
            <a href={pageUrl('/portfolio/')}>Portfolio</a>
            <a href={pageUrl('/contact/')}>Contact</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <a class="wordmark" href={pageUrl('/')} >STREEPS</a>
          <p>Meticulous painting for yachts and residences.</p>
        </div>
        <nav class="footer-links" aria-label="Footer navigation">
          <a href={pageUrl('/')}>Home</a>
          <a href={pageUrl('/portfolio/')}>Portfolio</a>
          <a href={pageUrl('/contact/')}>Contact</a>
          <a href="mailto:infostreeps@icloud.com">infostreeps@icloud.com</a>
        </nav>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} STREEPS</span>
      </div>
    </footer>
  </body>
</html>
